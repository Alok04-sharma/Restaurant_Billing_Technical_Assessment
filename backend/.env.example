# Path: backend/.env.example
# Copy configuration keys to backend/.env, but never commit real credentials.
PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb+srv://DATABASE_USER:ENCODED_PASSWORD@CLUSTER.mongodb.net/restaurant_billing?retryWrites=true&w=majority&authSource=admin
CLIENT_ORIGIN=http://localhost:5173
# Generate locally with: openssl rand -hex 32
SESSION_SECRET=PASTE_A_RANDOM_64_CHARACTER_HEX_STRING_HERE
